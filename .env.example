# Copy to .env.local. Never commit real values.
# Local values come from `npx supabase status`. Production: [[ENV: ...]] from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # [[ENV: NEXT_PUBLIC_SUPABASE_ANON_KEY]] (publishable / anon key)
# Server-only. Used to record verified payment outcomes and to disable sign-in after a completed erasure.
SUPABASE_SERVICE_ROLE_KEY=               # [[ENV: SUPABASE_SERVICE_ROLE_KEY]]
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # [[ENV: NEXT_PUBLIC_SITE_URL]] production origin

# Payments. With none configured, checkout shows "payments not yet activated".
# M-Pesa Daraja (sandbox first): [[ENV: MPESA_*]]
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=          # public https origin Daraja can reach
MPESA_CALLBACK_TOKEN=             # long random string; part of the secret callback path
# Local/test only: a gateway that moves no money. Never enable in production.
PAYMENTS_TEST_MODE=
PAYMENTS_TEST_WEBHOOK_SECRET=

# Notifications (Phase 4). Without these, outbound messages are recorded as "skipped".
CRON_SECRET=                      # protects /api/jobs/deliver-notifications
AFRICASTALKING_USERNAME=          # "sandbox" for the AT sandbox
AFRICASTALKING_API_KEY=
SMS_SENDER_ID=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Monitoring (Phase 6). Server errors are always logged as one redacted JSON line.
# Optionally also POST them to an ingestion endpoint (Sentry/Better Stack/internal webhook).
ERROR_REPORT_URL=                 # [[ENV: ERROR_REPORT_URL]]
ERROR_REPORT_TOKEN=               # [[ENV: ERROR_REPORT_TOKEN]] sent as a Bearer token, if your endpoint needs one
RELEASE=                          # optional release label when not on Vercel
